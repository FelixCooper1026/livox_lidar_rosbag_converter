  <version>0.0.1</version>
  <description>Livox LiDAR ROS 2 bag format converter between PointCloud2 and livox_ros_driver2 CustomMsg</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

